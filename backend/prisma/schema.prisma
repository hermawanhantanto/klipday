generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BRAND
  CLIPPER
}

enum UserStatus {
  ACTIVE
  DELETED
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String?
  role       Role
  status     UserStatus @default(ACTIVE)
  // Email confirmed (flipped by a future email-verification flow)
  isVerified Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  brand      Brand?
  clipper    Clipper?
}

model Brand {
  id          String   @id @default(cuid())
  companyName String
  industry    String
  phoneNumber String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Clipper {
  id        String   @id @default(cuid())
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
